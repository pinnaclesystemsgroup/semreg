<?xml version="1.0" encoding="UTF-8"?>
<cmap xmlns="http://cmap.ihmc.us/xml/cmap/"
      xmlns:dc="http://purl.org/dc/elements/1.1/"
      xmlns:dcterms="http://purl.org/dc/terms/">
  <res-meta>
    <dc:title>DataBOM Stewardship Metadata</dc:title>
    <dc:description>What stewardship metadata attributes are required for ADAPT data governance?</dc:description>
    <dc:creator>P. Isaac Riley</dc:creator>
    <dcterms:created>2026-06-05T00:00:00Z</dcterms:created>
  </res-meta>
  <map>
    <concept-list>
      <concept id="C0006001" label="DataCustodyRecord" long-comment="A record documenting the chain of custody for agricultural data, including originator attestation, transfer events, and cryptographic integrity verification."/>
      <concept id="C0006010" label="PurposeClassification" long-comment="A classification scheme for the intended purpose of agricultural data collection and use, aligned with XACML policy enforcement."/>
      <concept id="C0006020" label="MethodologyVersion" long-comment="A versioned reference to the scientific or regulatory methodology applied during agricultural data collection, enabling reproducibility and statutory protection against science-driven devaluation."/>
      <concept id="C0006030" label="PolicyEnforcement" long-comment="Mechanisms for enforcing data governance policies including XACML policy references, attestation levels, and statutory buffer pool requirements."/>
      <concept id="C0006002" label="OriginatorAttestation" long-comment="A signed declaration by the data originator confirming the provenance, collection conditions, and completeness of an agricultural data record."/>
      <concept id="C0006003" label="TransferCustodyEvent" long-comment="A recorded event documenting the transfer of data custody from one party to another, including timestamp, parties involved, and transfer conditions."/>
      <concept id="C0006004" label="CustodyChainHash" long-comment="A cryptographic hash of the complete custody chain, enabling tamper-evident verification of data provenance integrity."/>
      <concept id="C0006011" label="PrimaryAgriculturalPurpose" long-comment="Classification of data collected primarily for agricultural production management including planting, application, and harvest operations."/>
      <concept id="C0006012" label="CompliancePurpose" long-comment="Classification of data collected or processed for regulatory compliance including FSA reporting, crop insurance, and conservation program documentation."/>
      <concept id="C0006013" label="CommercialPurpose" long-comment="Classification of data collected or processed for commercial transactions including carbon credit attestation, commodity grading, and supply chain traceability."/>
      <concept id="C0006021" label="CarbonMethodologyRef" long-comment="A versioned reference to the carbon accounting methodology applied during data collection, required for carbon credit attestation and statutory protection against methodology-driven devaluation."/>
      <concept id="C0006022" label="YieldNormalizationMethodRef" long-comment="A versioned reference to the yield normalization methodology applied during data processing, enabling reproducible comparison across growing seasons and geographies."/>
      <concept id="C0006031" label="XACMLPolicyURI" long-comment="A resolvable URI reference to the XACML 3.0 policy document governing permitted uses of an agricultural data record under the AgDataCM framework."/>
      <concept id="C0006032" label="AttestationLevel" long-comment="An ordinal classification of the verification strength applied to an agricultural data record, ranging from self-attested producer declaration to hardware-anchored ZTI attestation."/>
      <concept id="C0006033" label="StatutoryBufferPool" long-comment="A mandatory 10 percent stability reserve indemnifying agricultural lenders against carbon credit devaluation, ensuring 1:1 collateral coverage per the CeR/CAU framework."/>
    </concept-list>
